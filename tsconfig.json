{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "llm-large-files": ["./src/index.ts"],
      "llm-large-files/gemini": ["./src/gemini/index.ts"],
      "llm-large-files/node": ["./src/node/index.ts"]
    }
  },
  "include": ["src", "test", "examples"]
}
