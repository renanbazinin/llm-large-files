{
  "name": "llm-large-files",
  "version": "0.8.2",
  "description": "Let an LLM answer questions about books, logs, and other files larger than its request limit or context window: upload, plan, search and read tools, map-reduce, a look at the pages of a PDF, and one tool loop for any model. Adapters for Gemini and Vertex AI, OpenAI-compatible endpoints, and Claude.",
  "keywords": [
    "llm",
    "gemini",
    "vertex-ai",
    "large-files",
    "long-context",
    "context-window",
    "function-calling",
    "tool-calling",
    "map-reduce",
    "logs",
    "pdf",
    "rag",
    "chatbot",
    "openai",
    "anthropic",
    "claude",
    "deepseek"
  ],
  "license": "MIT",
  "author": "renanbazinin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renanbazinin/llm-large-files.git"
  },
  "homepage": "https://github.com/renanbazinin/llm-large-files#readme",
  "bugs": {
    "url": "https://github.com/renanbazinin/llm-large-files/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./gemini": {
      "types": "./dist/gemini/index.d.ts",
      "default": "./dist/gemini/index.js"
    },
    "./openai": {
      "types": "./dist/openai/index.d.ts",
      "default": "./dist/openai/index.js"
    },
    "./anthropic": {
      "types": "./dist/anthropic/index.d.ts",
      "default": "./dist/anthropic/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./node/ingest-child.js": "./dist/node/ingest-child.js",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "gemini": [
        "./dist/gemini/index.d.ts"
      ],
      "openai": [
        "./dist/openai/index.d.ts"
      ],
      "anthropic": [
        "./dist/anthropic/index.d.ts"
      ],
      "node": [
        "./dist/node/index.d.ts"
      ],
      "testing": [
        "./dist/testing/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage --project unit --testTimeout=60000",
    "check": "npm run typecheck && npm test && npm run build",
    "eval:replay": "node evals/cli.mjs replay",
    "eval:record": "node evals/cli.mjs record",
    "eval:live": "node evals/cli.mjs live",
    "eval:recheck": "node evals/cli.mjs recheck",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "jszip": "^3.10.0",
    "unpdf": "^1.4.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "@cantoo/pdf-lib": {
      "optional": true
    },
    "jszip": {
      "optional": true
    },
    "unpdf": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@types/node": "^22.12.0",
    "@vitest/coverage-v8": "4.1.12",
    "jszip": "3.10.1",
    "typescript": "5.9.3",
    "unpdf": "1.4.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "vite": "7.3.7"
  }
}
